[Unit]
Description=Touch panel (rooms) on the 3.5in SPI TFT
After=multi-user.target docker.service
Conflicts=lcd35-status.service

[Service]
ExecStart=/usr/bin/python3 /home/orangepi/lcd35/panel.py
WorkingDirectory=/home/orangepi/lcd35
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
